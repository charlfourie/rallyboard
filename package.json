{
  "name": "rallyboard",
  "version": "0.1.0",
  "private": true,
  "description": "Free, open-source feedback and roadmap board for indie game developers, with Discord built in.",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "node scripts/migrate.mjs && node scripts/seed-demo.mjs --if-enabled && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed-demo": "node scripts/seed-demo.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@vercel/blob": "^2.9.0",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.5",
    "typescript": "5.9"
  }
}
