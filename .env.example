# --- Required -------------------------------------------------------------

# Postgres connection string. Neon, Supabase or your own server all work.
# For Neon or Supabase, use the *pooled* connection string.
DATABASE_URL=postgres://rallyboard:rallyboard@localhost:5432/rallyboard

# Random secret used to sign sessions. Generate one with:  npx auth secret
AUTH_SECRET=

# The public URL of your board, without a trailing slash.
AUTH_URL=http://localhost:3000

# Discord application (https://discord.com/developers/applications).
# OAuth2 redirect to add in Discord:  <AUTH_URL>/api/auth/callback/discord
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# --- Optional -------------------------------------------------------------

# Who becomes the owner. If neither is set, the FIRST person to sign in
# becomes the owner, so finish setup straight after deploying.
OWNER_EMAIL=
OWNER_DISCORD_ID=

# Email magic-link sign-in. Leave empty to offer Discord sign-in only.
# Example: smtp://user:password@smtp.example.com:587
EMAIL_SERVER=
EMAIL_FROM="Rallyboard <noreply@example.com>"

# Logo storage. On Vercel, connect a Blob store and this is set for you.
# Without it, uploads are saved to ./data/uploads on the server's disk.
BLOB_READ_WRITE_TOKEN=
